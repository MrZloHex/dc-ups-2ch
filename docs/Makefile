# DC-UPS-2CH — LaTeX documentation build
#
# Requires: TeX Live 2020+ (or MiKTeX) with xelatex and latexmk, plus the
# DejaVu font family (part of texlive-fontsextra / DejaVu system fonts).
#
# Targets:
#   make          # same as `make all` — build every PDF (regenerates build_info first)
#   make all      # build every PDF listed in TARGETS
#   make doc      # build both language variants of the passport
#   make manual   # build both language variants of the user manual
#   make en       # build the two English PDFs
#   make ru       # build the two Russian PDFs + label
#   make label    # build only the enclosure label
#   make watch    # rebuild on save (needs latexmk -pvc)
#   make clean    # remove intermediate build artefacts, keep the PDFs
#   make distclean# remove intermediates AND the PDFs
#   make version  # print the build identity that will be baked into the PDFs
#
# The values baked into the PDFs come from these variables (env-overridable
# so the root Makefile stays authoritative when it drives us):
#
#   VERSION     — semantic version (default: contents of ../VERSION)
#   GIT_HASH    — short commit hash + "-dirty" (default: derived from git)
#   BUILD_DATE  — UTC build date YYYY-MM-DD (default: date -u today)
#   HW_VERSION  — hardware revision printed on the passport / label (default: v2.1)
#   DOCREV      — document revision label (default: same as GIT_HASH)

# ------------------------- Build identity -------------------------
# Each identity variable can be overridden from the environment or the
# command line. The root Makefile exports these when driving us so both
# sides stamp the same values; running this Makefile standalone derives
# them from VERSION file + git.

ifndef VERSION
VERSION := $(shell test -f ../VERSION && head -n1 ../VERSION | tr -d '[:space:]' || echo dev)
endif

ifndef GIT_HASH
GIT_HASH_RAW := $(shell git -C .. rev-parse --short HEAD 2>/dev/null || echo unknown)
GIT_DIRTY    := $(shell test -n "$$(git -C .. status --porcelain 2>/dev/null)" && echo -dirty)
GIT_HASH     := $(GIT_HASH_RAW)$(GIT_DIRTY)
endif

ifndef BUILD_DATE
BUILD_DATE := $(shell date -u +%Y-%m-%d)
endif

HW_VERSION ?= v2.1
DOCREV     ?= $(GIT_HASH)

# ------------------------- Tools & sources -------------------------

LATEXMK     := latexmk
LATEXMKOPTS := -xelatex -interaction=nonstopmode -halt-on-error -file-line-error

# List every top-level .tex here. Anything that gets \include'd is picked
# up automatically by latexmk.
SOURCES := DC_UPS_documentation_v6.tex    \
           DC_UPS_documentation_v6_en.tex \
           DC_UPS_user_manual_v6.tex      \
           DC_UPS_user_manual_v6_en.tex   \
           DC_UPS_label_v6.tex

TARGETS := $(SOURCES:.tex=.pdf)

BUILD_INFO      := build_info.tex
BUILD_INFO_JSON := build_info.json

.PHONY: all doc manual label en ru watch clean distclean help version build_info
.DEFAULT_GOAL := all

# ------------------------- Targets -------------------------

all: $(TARGETS)

doc:    DC_UPS_documentation_v6.pdf DC_UPS_documentation_v6_en.pdf
manual: DC_UPS_user_manual_v6.pdf   DC_UPS_user_manual_v6_en.pdf
label:  DC_UPS_label_v6.pdf

# Convenience: build just one language.
en: DC_UPS_documentation_v6_en.pdf DC_UPS_user_manual_v6_en.pdf
ru: DC_UPS_documentation_v6.pdf    DC_UPS_user_manual_v6.pdf    DC_UPS_label_v6.pdf

# Every PDF depends on the freshly regenerated build_info.
# .PHONY makes build_info always run, so the PDFs pick up new git hashes / dates
# even if no .tex source changed.
%.pdf: %.tex build_info
	$(LATEXMK) $(LATEXMKOPTS) $<

# Continuous rebuild — Ctrl-C to stop.
watch: build_info
	$(LATEXMK) $(LATEXMKOPTS) -pvc $(SOURCES)

# Regenerate build_info.tex / build_info.json from the current VERSION / git /
# date values. Written via printf to avoid shell interpretation surprises with
# special chars.
#
# build_info.tex is used by the LaTeX sources and is a build intermediate
# (gitignored). build_info.json is fetched by docs/index.html at load time so
# GitHub Pages always shows the currently-committed HW/FW stamp — it IS
# committed to the repo alongside the PDFs.
build_info:
	@printf '%s\n' \
	  '% Auto-generated by docs/Makefile — do not edit; run `make build_info`.' \
	  '\newcommand{\hwversion}{$(HW_VERSION)}' \
	  '\newcommand{\fwversion}{$(VERSION)}' \
	  '\newcommand{\builddate}{$(BUILD_DATE)}' \
	  '\newcommand{\buildcommit}{$(GIT_HASH)}' \
	  '\newcommand{\docrev}{$(DOCREV)}' \
	  > $(BUILD_INFO)
	@printf '{\n  "hw":     "%s",\n  "fw":     "%s",\n  "date":   "%s",\n  "commit": "%s",\n  "docrev": "%s"\n}\n' \
	  '$(HW_VERSION)' '$(VERSION)' '$(BUILD_DATE)' '$(GIT_HASH)' '$(DOCREV)' \
	  > $(BUILD_INFO_JSON)
	@echo "[docs] build_info: HW=$(HW_VERSION) FW=$(VERSION) HASH=$(GIT_HASH) DATE=$(BUILD_DATE) DOCREV=$(DOCREV)"

version:
	@echo "HW_VERSION = $(HW_VERSION)"
	@echo "VERSION    = $(VERSION)"
	@echo "GIT_HASH   = $(GIT_HASH)"
	@echo "BUILD_DATE = $(BUILD_DATE)"
	@echo "DOCREV     = $(DOCREV)"

# Remove intermediates but keep the finished PDFs so the repo stays useful
# without a TeX toolchain.
clean:
	$(LATEXMK) -c $(SOURCES) 2>/dev/null || true
	rm -f *.aux *.log *.out *.toc *.synctex.gz *.fls *.fdb_latexmk \
	      *.bcf *.run.xml *.blg *.bbl *.lof *.lot *.xdv *.nav *.snm \
	      *.vrb *-eps-converted-to.pdf $(BUILD_INFO)
	@# build_info.json is intentionally kept — it's served from Pages.

# Wipe everything, including the PDFs.
distclean: clean
	$(LATEXMK) -C $(SOURCES) 2>/dev/null || true
	rm -f $(TARGETS)

help:
	@echo "Targets: all doc manual label watch clean distclean version build_info"
	@echo "Sources: $(SOURCES)"
	@echo "Outputs: $(TARGETS)"
	@echo ""
	@$(MAKE) --no-print-directory version
