String field(const String &label,
             const String &name,
             const String &value,
             const String &hint = "",
             const String &type = "text")
{
    String h = hint == "" ? "" : "<small>" + htmlEscape(hint) + "</small>";
    return "<label>" + htmlEscape(label) + h +
           "<input type='" + htmlEscape(type) +
           "' name='" + htmlEscape(name) +
           "' value='" + htmlEscape(value) + "'></label>";
}

